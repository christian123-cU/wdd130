# --- Server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=challengeaid_disbursement
PGUSER=postgres
PGPASSWORD=changeme

# --- Auth ---
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Redis (notification queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SMS Gateway (Phase 2 — trustee/approver reminders) ---
# Left blank in Phase 1. The worker will log a warning and skip sending
# rather than fail, so the rest of the system works without this.
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=ChallengeAid

# --- Seed defaults (only used by npm run seed) ---
SEED_ADMIN_EMAIL=admin@challengeaid.org
SEED_ADMIN_PASSWORD=ChangeMe123!
